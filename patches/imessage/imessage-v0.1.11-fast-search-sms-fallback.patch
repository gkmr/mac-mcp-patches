+// ---- Patched 2026-07-07: fast contact search via AddressBook SQLite ----
+// The original AppleScript loop makes several Apple Events round trips per
+// contact (thousands of contacts -> minutes of IPC) and times out. Querying
+// the AddressBook databases directly returns in milliseconds and relies on
+// the same Full Disk Access already required for chat.db. AppleScript
+// remains as a timeout-capped fallback only.
+
+async function findAddressBookDBs() {
+  const base = `${process.env.HOME}/Library/Application Support/AddressBook`;
+  const dbs = [];
+  try {
+    await access(`${base}/AddressBook-v22.abcddb`);
+    dbs.push(`${base}/AddressBook-v22.abcddb`);
+  } catch {}
+  try {
+    const sources = await readdir(`${base}/Sources`);
+    for (const source of sources) {
+      const dbPath = `${base}/Sources/${source}/AddressBook-v22.abcddb`;
+      try {
+        await access(dbPath);
+        dbs.push(dbPath);
+      } catch {}
+    }
+  } catch {}
+  return dbs;
+}
+
+function sqlEscapeLike(value) {
+  return String(value).replace(/'/g, "''").replace(/[%_\\]/g, "");
+}
+
+async function searchContactsSQLite(query, limit = 50) {
+  const dbs = await findAddressBookDBs();
+  if (dbs.length === 0) {
+    throw new Error("No AddressBook databases found");
+  }
+
+  const stripPhone = (col) =>
+    `replace(replace(replace(replace(replace(${col},' ',''),'-',''),'(',''),')',''),'.','')`;
+
+  const tokens = String(query).trim().split(/\s+/).filter(Boolean);
+  const tokenConds = tokens.map((rawToken) => {
+    const t = sqlEscapeLike(rawToken);
+    const digits = rawToken.replace(/[^0-9]/g, "");
+    let cond = `(r.ZFIRSTNAME LIKE '%${t}%' OR r.ZLASTNAME LIKE '%${t}%' OR r.ZNICKNAME LIKE '%${t}%' OR r.ZORGANIZATION LIKE '%${t}%' OR EXISTS(SELECT 1 FROM ZABCDEMAILADDRESS e2 WHERE e2.ZOWNER = r.Z_PK AND e2.ZADDRESS LIKE '%${t}%')`;
+    if (digits.length >= 3) {
+      cond += ` OR EXISTS(SELECT 1 FROM ZABCDPHONENUMBER p2 WHERE p2.ZOWNER = r.Z_PK AND ${stripPhone("p2.ZFULLNUMBER")} LIKE '%${digits}%')`;
+    }
+    return cond + ")";
+  });
+  const where = tokenConds.length > 0 ? tokenConds.join(" AND ") : "1=1";
+
+  const sql = `SELECT
+      COALESCE(r.ZFIRSTNAME,'') AS first,
+      COALESCE(r.ZLASTNAME,'') AS last,
+      COALESCE(r.ZNICKNAME,'') AS nick,
+      COALESCE(r.ZORGANIZATION,'') AS org,
+      (SELECT group_concat(p.ZFULLNUMBER,'||') FROM ZABCDPHONENUMBER p WHERE p.ZOWNER = r.Z_PK) AS phones,
+      (SELECT group_concat(e.ZADDRESS,'||') FROM ZABCDEMAILADDRESS e WHERE e.ZOWNER = r.Z_PK) AS emails
+    FROM ZABCDRECORD r
+    WHERE ${where}
+    LIMIT ${Number(limit) || 50};`;
+
+  const seen = new Set();
+  const results = [];
+  let okCount = 0;
+  for (const db of dbs) {
+    try {
+      const { stdout } = await execFileAsync(
+        "sqlite3",
+        ["-readonly", "-json", "-cmd", ".timeout 2000", db, sql],
+        { timeout: 10000 }
+      );
+      okCount++;
+      if (!stdout.trim()) continue;
+      for (const row of JSON.parse(stdout)) {
+        const name =
+          [row.first, row.last].filter(Boolean).join(" ").trim() ||
+          row.nick || row.org || "";
+        const phones = row.phones ? row.phones.split("||").filter(Boolean) : [];
+        const emails = row.emails ? row.emails.split("||").filter(Boolean) : [];
+        if (!name && phones.length === 0 && emails.length === 0) continue;
+        const key = `${name.toLowerCase()}|${phones.join(",")}|${emails.join(",")}`;
+        if (seen.has(key)) continue;
+        seen.add(key);
+        const contact = { name: name || "Unknown", phones, emails };
+        if (row.nick) contact.nickname = row.nick;
+        if (row.org) contact.organization = row.org;
+        results.push(contact);
+      }
+    } catch (error) {
+      console.error(`AddressBook query failed for ${db}: ${getErrorMessage(error)}`);
+    }
+  }
+  if (okCount === 0) {
+    throw new Error("All AddressBook database queries failed");
+  }
+  return results;
+}
