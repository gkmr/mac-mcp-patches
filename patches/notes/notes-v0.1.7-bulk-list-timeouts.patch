+            content: [
+              {
+                type: "text",
+                text: JSON.stringify(notes, null, 2),
+              },
+            ],
+          };
+        } catch (error) {
+          console.error("Bulk list_notes failed, falling back to legacy loop:", getErrorMessage(error));
+        }
+      }
