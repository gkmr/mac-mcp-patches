+            set modDates to modification date of ${src}
+          end tell
+          set maxN to count of noteNames
+          if maxN > ${limit} then set maxN to ${limit}
+          set out to {}
+          repeat with i from 1 to maxN
+            set end of out to (item i of noteNames) & us & (item i of noteIds) & us & ((item i of createDates) as string) & us & ((item i of modDates) as string)
+          end repeat
+          set AppleScript's text item delimiters to rs
+          set outStr to out as string
+          set AppleScript's text item delimiters to ""
+          return outStr
+        `;
+        try {
